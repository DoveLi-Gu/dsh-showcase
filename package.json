{
  "name": "dsh-showcase",
  "version": "0.1.0",
  "description": "Local, verifiable delivery evidence reports for coding-agent work.",
  "type": "module",
  "license": "MIT",
  "keywords": ["deepseek-harness", "dsh-plugin", "coding-agent", "proof-of-work", "developer-tools"],
  "exports": { "./plugin": "./plugin/index.js" },
  "files": ["dist", "plugin", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CHARACTER_ASSET_NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
