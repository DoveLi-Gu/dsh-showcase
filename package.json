{
  "name": "dsh-showcase",
  "version": "0.1.1",
  "description": "Local, verifiable delivery evidence reports for coding-agent work.",
  "type": "module",
  "main": "./plugin/client-host.js",
  "license": "MIT",
  "author": "DoveLi-Gu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoveLi-Gu/dsh-showcase.git"
  },
  "homepage": "https://github.com/DoveLi-Gu/dsh-showcase#readme",
  "bugs": {
    "url": "https://github.com/DoveLi-Gu/dsh-showcase/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "coding-agent",
    "delivery-evidence",
    "proof-of-work",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.15.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./plugin/client-host.js",
    "./plugin": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "files": [
    "plugin/client-host.js",
    "plugin/client.js",
    "plugin/index.d.ts",
    "plugin/index.js",
    "plugin/layout-summary.d.ts",
    "plugin/layout-summary.js",
    "plugin/poster-html.js",
    "plugin/report-schema.js",
    "plugin/assets/dijiang-survey-surface.webp",
    "plugin/assets/whale-girl-keyvisual.webp",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CHARACTER_ASSET_NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run build && npm run pack:check",
    "prepublishOnly": "npm run check",
    "cli": "tsx src/cli/index.ts",
    "init": "tsx src/cli/index.ts init",
    "capture": "tsx src/cli/index.ts capture"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "latest"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
