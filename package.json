    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "init": "tsx src/cli/index.ts init",
    "capture": "tsx src/cli/index.ts capture"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1", "@vitejs/plugin-react": "latest", "lucide-react": "latest", "react": "latest", "react-dom": "latest", "zod": "latest" },
  "peerDependencies": { "@deepseek-ai/dsh-tools": "^0.1.0-rc.6", "@deepseek-ai/cordis": "^4.0.1" },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/dsh-tools": "^0.1.0-rc.6", "@types/node": "latest", "@types/react": "latest", "@types/react-dom": "latest", "typescript": "latest", "vite": "latest", "vitest": "latest", "tsx": "latest", "jsdom": "latest" }
}
